{
  "name": "@breadai/transport-http-chunked",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@breadai/core": "workspace:>=0.1.1 <1.0.0",
    "hono": "^4.8.4"
  },
  "devDependencies": {
    "@breadai/server": "workspace:*",
    "@breadai/store-memory": "workspace:*",
    "@breadai/test-utils": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3",
    "zod": "^4.4.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "description": "HTTP (chunked NDJSON) BreadTransport for bread — a mount()-able server ingress plus a remoteAgent() client speaking the Bread protocol over one connection.",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "http",
    "ndjson",
    "chunked",
    "bread"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "transports/http-chunked"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
