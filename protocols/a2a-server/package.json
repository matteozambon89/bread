{
  "name": "@breadai/protocol-a2a-server",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@breadai/core": "workspace:>=0.1.1 <1.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@breadai/server": "workspace:*",
    "@breadai/test-utils": "workspace:*",
    "@types/bun": "latest",
    "hono": "^4.8.4",
    "typescript": "^5.8.3",
