{
  "name": "@breadai/protocol-mcp-server",
  "version": "0.1.1",
  "description": "MCP server plugin for bread — expose selected agents, tasks, tools, and skills as MCP tools over stdio or Streamable HTTP, riding whatever auth middleware your server already has configured.",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tools",
    "bread",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "protocols/mcp-server"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@breadai/core": "workspace:*",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.11.4",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@breadai/server": "workspace:*",
    "@breadai/test-utils": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
