# Record from /tmp, not the repo. `bread` on PATH execs this worktree's CLI.

Output bread-init.gif

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 16
Set Width 1000
Set Height 640
Set Theme "Catppuccin Mocha"
Set Padding 16
Set TypingSpeed 35ms

Hide
Type "export PATH=/opt/homebrew/bin:/tmp/bread-vhs-bin:$PATH"
Enter
Type "export PS1='$ '"
Enter
Type "unset NO_COLOR"
Enter
Type "cd /tmp && rm -rf demo-app"
Enter
Type "clear"
Enter
Show

Type "bread init demo-app --no-install"
Sleep 700ms
Enter
Sleep 700ms
Enter
Sleep 700ms
Enter
Sleep 700ms
Enter
Sleep 700ms
Enter
Sleep 700ms
Type "anthropic"
Sleep 700ms
Enter
Sleep 700ms
Type "claude-opus-5-5"
Sleep 700ms
Enter
Sleep 2s
