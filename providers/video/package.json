{
  "name": "@breadai/provider-video",
  "version": "0.1.0",
  "description": "Video-model providers for bread — 13 lazily-imported AI SDK providers as a VideoRegistry for config.video.",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "bread",
    "provider",
    "video",
    "ai-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "providers/video"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@breadai/core": "workspace:>=0.1.6 <1.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/alibaba": ">=2.0",
    "@ai-sdk/black-forest-labs": ">=2.0",
    "@ai-sdk/bytedance": ">=2.0",
    "@ai-sdk/fal": ">=3.0",
    "@ai-sdk/google": ">=4.0",
    "@ai-sdk/google-vertex": ">=5.0",
    "@ai-sdk/heygen": ">=3.0",
    "@ai-sdk/klingai": ">=4.0",
    "@ai-sdk/minimax": ">=3.0",
    "@ai-sdk/prodia": ">=2.0",
    "@ai-sdk/replicate": ">=3.0",
    "@ai-sdk/topaz": ">=3.0",
    "@ai-sdk/xai": ">=5.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/alibaba": {
      "optional": true
    },
    "@ai-sdk/black-forest-labs": {
      "optional": true
    },
    "@ai-sdk/bytedance": {
      "optional": true
    },
    "@ai-sdk/fal": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "@ai-sdk/heygen": {
      "optional": true
    },
    "@ai-sdk/klingai": {
      "optional": true
    },
    "@ai-sdk/minimax": {
      "optional": true
    },
    "@ai-sdk/prodia": {
      "optional": true
    },
    "@ai-sdk/replicate": {
      "optional": true
    },
    "@ai-sdk/topaz": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
