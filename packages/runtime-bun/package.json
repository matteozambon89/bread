{
  "name": "@breadai/runtime-bun",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target bun --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@breadai/core": "workspace:>=0.1.1 <1.0.0",
    "@breadai/server": "workspace:>=0.1.3 <1.0.0"
  },
  "devDependencies": {
    "@breadai/store-memory": "workspace:*",
    "@breadai/test-utils": "workspace:*",
    "@breadai/transport-http-sse": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  },
  "description": "Bun listen adapter for @breadai/server (Hono app.fetch via Bun.serve).",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "bun",
    "server",
    "hono",
    "runtime",
    "bread"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "packages/runtime-bun"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
