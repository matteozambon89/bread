{
  "name": "@breadai/test-utils",
  "version": "0.1.0",
  "description": "Internal test harness for the bread monorepo — mock LLM models, an in-memory bread/server bootstrap, and a shared BreadStore contract suite. Not published.",
  "private": true,
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "type": "module",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bun ../../scripts/drop-stale-buildinfo.ts && tsc -b --pretty false --builders 1"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4",
    "@breadai/core": "workspace:*",
    "@breadai/server": "workspace:*",
    "@breadai/store-memory": "workspace:*",
    "@breadai/transport-http-sse": "workspace:*",
    "ai": "^7.0.93",
    "postgres": "^3.4.5",
    "uuid": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
