{
  "name": "@breadai/server",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@breadai/core": "workspace:>=0.1.1 <1.0.0",
    "@breadai/provider-catalog": "workspace:>=0.1.1 <1.0.0",
    "chokidar": "^4.0.3",
    "hono": "^4.8.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@breadai/store-memory": "workspace:*",
    "@breadai/test-utils": "workspace:*",
    "@breadai/transport-http-sse": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.8.3",
    "zod": "^4.4.3"
  },
  "description": "Hono server and file-system loader for the bread agent framework (importable library).",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "cli",
    "server",
    "hono",
    "dev-server",
    "bread"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
