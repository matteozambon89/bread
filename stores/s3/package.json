{
  "name": "@bread/store-s3",
  "version": "0.1.0",
  "description": "S3-backed BlobStore for bread — binary/file storage via presigned URLs, for any S3-compatible service (AWS S3, R2, MinIO, ...).",
  "license": "MIT",
  "author": "Matteo Zambon <matteo@yeeti.co>",
  "keywords": [
    "ai",
    "agents",
    "bread",
    "storage",
    "s3",
    "blob"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/matteozambon89/bread.git",
    "directory": "stores/s3"
  },
  "homepage": "https://github.com/matteozambon89/bread",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bread-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@bread/core": "workspace:*",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@bread/test-utils": "workspace:*",
    "@types/bun": "latest",
    "aws-sdk-client-mock": "^4.1.0",
    "typescript": "^5.8.3"
  }
}
